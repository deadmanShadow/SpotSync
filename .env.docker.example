# Sample env file consumed by `docker compose --env-file`.
# Copy this file to `.env.docker` (NOT committed) and edit the values.
#
# IMPORTANT:
#   - Do not commit `.env.docker` (only the `.example` template).
#   - JWT_SECRET is REQUIRED — the Go backend refuses to start without
#     it (see backend/internal/config/config.go). Use a long random
#     string in production.
#   - FRONTEND_URL must match the public URL the browser uses to load
#     the Astro frontend. The default below matches the host port
#     published in docker-compose.yml (4321).

JWT_SECRET=supersecretjwtkey_change_me
FRONTEND_URL=http://localhost:4321