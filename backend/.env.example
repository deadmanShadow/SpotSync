# SpotSync Backend - example environment file.
# Copy to `.env` and fill in real values for local development.
# `.env` is git-ignored; never commit real secrets.

# HTTP port Echo listens on locally.
APP_PORT=8080

# PostgreSQL connection string (Neon / Postgres / etc.).
DATABASE_URL=your-database-url

# Secret used to sign and verify JWTs. Use a long random string in production.
JWT_SECRET=your-jwt-secret

# Public origin of the Astro frontend. Echo CORS allows only this origin
# (set to your deployed frontend URL in production, e.g. https://spotsync.vercel.app).
FRONTEND_URL=http://localhost:4321
