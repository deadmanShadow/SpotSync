# SpotSync Frontend - example environment file.
# Copy to `.env` and fill in real values for local development.
# `.env` is git-ignored; never commit real secrets.

# Public base URL of the backend API (must start with `PUBLIC_` to be exposed
# to the browser bundle by Vite/Astro). All API requests are composed from this.
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
