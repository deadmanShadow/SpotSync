---
// Admin reservations monitor.
//
// Renders a tabular view of every booking in the system. The parent page
// is expected to populate the hidden `data-all-reservations` script tag
// with a JSON string of the `Reservation[]` payload. This keeps the
// component fully declarative on the server while still letting the
// client-side script apply the status filter without a network round
// trip.
---

<section
  class="glass-card overflow-hidden"
  aria-label="System reservation monitor"
  data-admin-reservations
>
  <header class="flex flex-col gap-4 border-b border-slate-800/80 p-5 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="font-display text-xl font-bold text-slate-50">Global reservation monitor</h2>
      <p class="mt-1 text-sm text-slate-400">Every active and historical booking across the SpotSync network.</p>
    </div>
    <div role="tablist" aria-label="Filter system reservations" class="inline-flex flex-wrap items-center gap-1 rounded-xl border border-slate-800/80 bg-slate-900/60 p-1 shadow-inner" data-admin-status-filter>
      <button type="button" role="tab" data-admin-status="all" aria-selected="true" class="rounded-lg px-4 py-2 text-sm font-semibold transition-all bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30">
        All
      </button>
      <button type="button" role="tab" data-admin-status="active" aria-selected="false" class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold text-slate-300 transition-all hover:bg-slate-800/60 hover:text-slate-100">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
        Active
      </button>
      <button type="button" role="tab" data-admin-status="cancelled" aria-selected="false" class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold text-slate-300 transition-all hover:bg-slate-800/60 hover:text-slate-100">
        <span class="h-1.5 w-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>
        Cancelled
      </button>
      <button type="button" role="tab" data-admin-status="completed" aria-selected="false" class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold text-slate-300 transition-all hover:bg-slate-800/60 hover:text-slate-100">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-400" aria-hidden="true"></span>
        Completed
      </button>
    </div>
  </header>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-950/40 text-[0.65rem] uppercase tracking-[0.18em] text-slate-400">
        <tr>
          <th scope="col" class="px-5 py-3 font-bold">Booking</th>
          <th scope="col" class="px-5 py-3 font-bold">Driver</th>
          <th scope="col" class="px-5 py-3 font-bold">Zone</th>
          <th scope="col" class="px-5 py-3 font-bold">License plate</th>
          <th scope="col" class="px-5 py-3 font-bold">Status</th>
          <th scope="col" class="px-5 py-3 font-bold">Reserved at</th>
        </tr>
      </thead>
      <tbody data-admin-rows class="divide-y divide-slate-800/80">
        <tr data-admin-empty>
          <td colspan="6" class="px-5 py-10 text-center text-slate-400">No reservations match this filter yet.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <footer class="flex items-center justify-between border-t border-slate-800/80 px-5 py-3 text-xs text-slate-400">
    <span data-admin-count>0 reservations shown</span>
    <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-slate-500">Live</span>
  </footer>
</section>

<script type="application/json" data-all-reservations>[]</script>

<script>
  import type { Reservation, ReservationStatus } from "../types/reservation";
  import type { ZoneType } from "../types/zone";

  type FilterValue = "all" | ReservationStatus;

  const STATUS_PILL: Record<ReservationStatus, { label: string; classes: string; dot: string }> = {
    active: {
      label: "Active",
      classes: "border-emerald-400/40 bg-emerald-500/15 text-emerald-200",
      dot: "bg-emerald-400",
    },
    completed: {
      label: "Completed",
      classes: "border-blue-400/30 bg-blue-500/15 text-blue-200",
      dot: "bg-blue-400",
    },
    cancelled: {
      label: "Cancelled",
      classes: "border-slate-500/40 bg-slate-700/40 text-slate-300",
      dot: "bg-slate-400",
    },
  };

  const TYPE_LABEL: Record<ZoneType, string> = {
    ev_charging: "EV Charging",
    general: "General",
    covered: "Covered",
  };

  const TYPE_CHIP: Record<ZoneType, string> = {
    ev_charging: "border-emerald-400/30 bg-emerald-500/15 text-emerald-300",
    general: "border-blue-400/30 bg-blue-500/15 text-blue-300",
    covered: "border-purple-400/30 bg-purple-500/15 text-purple-300",
  };

  function escapeHtml(input: string): string {
    return input
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const day = d.getDate();
    const month = months[d.getMonth()];
    const year = d.getFullYear();
    const hh = String(d.getHours()).padStart(2, "0");
    const mm = String(d.getMinutes()).padStart(2, "0");
    return `${day}-${month}-${year} ${hh}:${mm}`;
  }

  function readReservations(): Reservation[] {
    const node = document.querySelector<HTMLElement>("[data-all-reservations]");
    if (!node) return [];
    try {
      const parsed = JSON.parse(node.textContent ?? "[]") as unknown;
      return Array.isArray(parsed) ? (parsed as Reservation[]) : [];
    } catch {
      return [];
    }
  }

  function matches(reservation: Reservation, filter: FilterValue): boolean {
    if (filter === "all") return true;
    return reservation.status === filter;
  }

  function renderRow(reservation: Reservation): string {
    const zoneName = reservation.zone?.name ?? `Zone #${reservation.zone_id}`;
    const zoneType: ZoneType = reservation.zone?.type ?? "general";
    const typeLabel = TYPE_LABEL[zoneType];
    const typeChip = TYPE_CHIP[zoneType];
    const driverEmail = reservation.user?.email ?? `user#${reservation.user_id}`;
    const driverName = reservation.user?.name ?? "";
    const plate = (reservation.license_plate ?? "").trim() || "—";
    const status = reservation.status;
    const pill = STATUS_PILL[status] ?? STATUS_PILL.cancelled;

    return `
      <tr class="transition hover:bg-slate-900/60" data-reservation-row data-reservation-status="${status}">
        <td class="px-5 py-3 align-top">
          <span class="font-mono text-xs text-slate-300">#${reservation.id}</span>
        </td>
        <td class="px-5 py-3 align-top">
          <p class="font-semibold text-slate-100">${escapeHtml(driverEmail)}</p>
          ${driverName ? `<p class="text-xs text-slate-500">${escapeHtml(driverName)}</p>` : ""}
        </td>
        <td class="px-5 py-3 align-top">
          <p class="font-semibold text-slate-100">${escapeHtml(zoneName)}</p>
          <span class="mt-1 inline-flex items-center rounded-md border px-2 py-0.5 text-[0.65rem] font-semibold ${typeChip}">${escapeHtml(typeLabel)}</span>
        </td>
        <td class="px-5 py-3 align-top">
          <span class="inline-flex rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-1 font-mono text-xs font-bold tracking-widest text-slate-100">${escapeHtml(plate)}</span>
        </td>
        <td class="px-5 py-3 align-top">
          <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold ${pill.classes}">
            <span class="h-1.5 w-1.5 rounded-full ${pill.dot}" aria-hidden="true"></span>
            ${pill.label}
          </span>
        </td>
        <td class="px-5 py-3 align-top">
          <p class="font-mono text-xs text-slate-200">${escapeHtml(formatDate(reservation.created_at))}</p>
          <p class="text-[0.65rem] text-slate-500">${escapeHtml(reservation.created_at)}</p>
        </td>
      </tr>
    `;
  }

  function paint(filter: FilterValue): void {
    const body = document.querySelector<HTMLElement>("[data-admin-rows]");
    const emptyRow = document.querySelector<HTMLElement>("[data-admin-empty]");
    const countEl = document.querySelector<HTMLElement>("[data-admin-count]");
    if (!body || !emptyRow || !countEl) return;

    const reservations = readReservations();
    const filtered = reservations.filter((r) => matches(r, filter));

    if (filtered.length === 0) {
      body.innerHTML = "";
      body.appendChild(emptyRow);
      emptyRow.classList.remove("hidden");
      countEl.textContent = "0 reservations shown";
      return;
    }

    emptyRow.classList.add("hidden");
    body.innerHTML = filtered
      .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())
      .map(renderRow)
      .join("");
    countEl.textContent = `${filtered.length} reservation${filtered.length === 1 ? "" : "s"} shown`;
  }

  let currentFilter: FilterValue = "all";

  function bindFilter(): void {
    const container = document.querySelector<HTMLElement>("[data-admin-status-filter]");
    if (!container) return;
    container.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const button = target.closest<HTMLButtonElement>("[data-admin-status]");
      if (!button) return;
      const value = (button.dataset.adminStatus ?? "all") as FilterValue;

      currentFilter = value;

      container.querySelectorAll<HTMLButtonElement>("[data-admin-status]").forEach((btn) => {
        const selected = btn.dataset.adminStatus === value;
        btn.setAttribute("aria-selected", selected ? "true" : "false");
        if (selected) {
          btn.classList.add("bg-gradient-to-r", "from-emerald-500", "to-emerald-600", "text-white", "shadow-lg", "shadow-emerald-500/30");
          btn.classList.remove("text-slate-300", "hover:bg-slate-800/60", "hover:text-slate-100");
        } else {
          btn.classList.remove("bg-gradient-to-r", "from-emerald-500", "to-emerald-600", "text-white", "shadow-lg", "shadow-emerald-500/30");
          btn.classList.add("text-slate-300", "hover:bg-slate-800/60", "hover:text-slate-100");
        }
      });

      paint(currentFilter);
    });
  }

  function bindRefreshOnEvent(): void {
    window.addEventListener("spotsync:reservations-updated", (event) => {
      const detail = (event as CustomEvent<Reservation[]>).detail;
      const node = document.querySelector<HTMLElement>("[data-all-reservations]");
      if (node && Array.isArray(detail)) {
        node.textContent = JSON.stringify(detail);
      }
      paint(currentFilter);
    });
  }

  bindFilter();
  bindRefreshOnEvent();
  paint(currentFilter);
</script>
