---
// ZoneCard.astro
//
// Renders a single parking zone in the home-page catalog grid.
//
// Visual elements:
//   - Zone name as the headline
//   - Type badge (ev_charging / general / covered) with a matching icon
//   - Hourly price tag
//   - Dynamic capacity progress bar (green > 50%, amber 20-50%, red < 20%)
//   - "Reserve Spot" trigger that opens the ReserveModal for this zone
//
// The card is rendered server-side from the props but the "Reserve Spot"
// button is wired up by the parent page's client script (uses data-zone-id
// attributes so we don't need any per-zone script tag here).

import type { ParkingZone } from "../types/zone";

interface Props {
  zone: ParkingZone;
}

const { zone } = Astro.props;

// Defensive numeric coercion — backend always sends integers, but TypeScript
// can't enforce that at runtime so we guard the math against bad payloads.
const total = Math.max(0, zone.total_capacity);
const available = Math.max(0, zone.available_spots);
const occupied = Math.max(0, total - available);

// % of full, capped at [0, 100] so we never overflow the bar.
const fillPercent = total === 0 ? 0 : Math.min(100, (available / total) * 100);

// Color rules per the design spec.
let barColor = "bg-emerald-500";
let barShadow = "shadow-emerald-500/40";
let statusLabel = "Open";
if (available <= 0) {
  barColor = "bg-red-500";
  barShadow = "shadow-red-500/40";
  statusLabel = "Full";
} else if (fillPercent < 20) {
  barColor = "bg-red-500";
  barShadow = "shadow-red-500/40";
  statusLabel = "Almost Full";
} else if (fillPercent < 50) {
  barColor = "bg-amber-500";
  barShadow = "shadow-amber-500/40";
  statusLabel = "Filling Up";
}

// Type badge config: icon + colors + label.
type Badge = {
  icon: string;
  label: string;
  classes: string;
};

const TYPE_BADGES: Record<ParkingZone["type"], Badge> = {
  ev_charging: {
    icon: "zap",
    label: "EV Charging",
    classes: "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
  },
  general: {
    icon: "car",
    label: "General",
    classes: "bg-blue-500/10 text-blue-300 border-blue-500/30",
  },
  covered: {
    icon: "shield",
    label: "Covered",
    classes: "bg-purple-500/10 text-purple-300 border-purple-500/30",
  },
};

const badge = TYPE_BADGES[zone.type] ?? TYPE_BADGES.general;

const priceFormatted = `$${zone.price_per_hour.toFixed(2)}/hr`;
const isFull = available <= 0;
---

<article
  class="glass-card p-6 flex flex-col gap-4 group hover:border-slate-700/80 transition-all"
  data-zone-card
  data-zone-id={zone.id}
  data-zone-name={zone.name}
  data-zone-type={zone.type}
  data-zone-available={available}
  data-zone-total={total}
>
  <!-- Header: name + type badge -->
  <header class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="font-display text-xl font-bold text-slate-50 leading-tight truncate">
        {zone.name}
      </h3>
      <p class="text-xs text-slate-400 mt-1">
        Zone #{zone.id}
      </p>
    </div>
    <span
      class:list={[
        "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold border whitespace-nowrap",
        badge.classes,
      ]}
    >
      {badge.icon === "zap" && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      )}
      {badge.icon === "car" && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true">
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
      )}
      {badge.icon === "shield" && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
        </svg>
      )}
      {badge.label}
    </span>
  </header>

  <!-- Price tag -->
  <div class="flex items-center gap-2">
    <span class="inline-flex items-center px-3 py-1 rounded-lg bg-slate-800/60 border border-slate-700/60 text-sm font-semibold text-slate-100">
      {priceFormatted}
    </span>
    <span
      class:list={[
        "inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold",
        isFull
          ? "bg-red-500/10 text-red-300 border border-red-500/30"
          : fillPercent < 20
          ? "bg-red-500/10 text-red-300 border border-red-500/30"
          : fillPercent < 50
          ? "bg-amber-500/10 text-amber-300 border border-amber-500/30"
          : "bg-emerald-500/10 text-emerald-300 border border-emerald-500/30",
      ]}
    >
      {statusLabel}
    </span>
  </div>

  <!-- Dynamic capacity progress bar -->
  <div class="space-y-2">
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-300">
        <span class="font-bold text-slate-50" data-available-count>{available}</span>
        <span class="text-slate-400"> of </span>
        <span class="font-semibold text-slate-100" data-total-count>{total}</span>
        <span class="text-slate-400"> spots available</span>
      </span>
      <span class="text-xs text-slate-500" data-fill-percent>{Math.round(fillPercent)}%</span>
    </div>
    <div class="h-2.5 w-full bg-slate-800/80 rounded-full overflow-hidden border border-slate-700/50">
      <div
        class:list={["h-full rounded-full transition-all duration-500 shadow-lg", barColor, barShadow]}
        style={`width: ${fillPercent}%`}
        data-progress-bar
      ></div>
    </div>
    <p class="text-xs text-slate-500">
      {occupied} spot{occupied === 1 ? "" : "s"} currently occupied
    </p>
  </div>

  <!-- Reserve trigger -->
  <div class="pt-2 mt-auto">
    <button
      type="button"
      class:list={[
        "w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl font-semibold text-sm transition-all",
        isFull
          ? "bg-slate-800/60 text-slate-500 border border-slate-700/60 cursor-not-allowed"
          : "bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:from-emerald-400 hover:to-emerald-500",
      ]}
      data-reserve-trigger
      data-zone-id={zone.id}
      disabled={isFull}
      aria-disabled={isFull ? "true" : "false"}
    >
      {isFull ? (
        <>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
          </svg>
          Zone Full
        </>
      ) : (
        <>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          Reserve Spot
        </>
      )}
    </button>
  </div>
</article>
