---
/**
 * AdminGuard
 *
 * Astro component that renders a "you must be an admin" panel when the
 * current user is not an authenticated administrator. Pages wrap their
 * main content in <AdminGuard>...</AdminGuard> and the parent script is
 * responsible for toggling the data attribute based on auth state.
 *
 * The actual role check is done client-side so this can be statically
 * rendered. The SSR markup defaults to "checking…", which is then
 * replaced with either the slotted content (admin) or the forbidden
 * panel (non-admin / unauthenticated).
 */
---

<div class="admin-guard" data-admin-guard>
  <div class="admin-guard__checking" data-admin-guard-status="checking">
    <div class="admin-guard__spinner" aria-hidden="true"></div>
    <p class="admin-guard__checking-label">Verifying admin access…</p>
  </div>

  <div class="admin-guard__forbidden hidden" data-admin-guard-status="forbidden" role="alert">
    <span class="admin-guard__forbidden-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </span>
    <h2 class="admin-guard__forbidden-title">Administrator access required</h2>
    <p class="admin-guard__forbidden-desc">
      Your account doesn't have the <strong>admin</strong> role. Make sure
      you signed in with the administrator account — there is no separate
      super-admin tier in SpotSync.
    </p>
    <a href="/" class="admin-guard__forbidden-cta">Return Home</a>
  </div>

  <div class="hidden" data-admin-guard-status="ready">
    <slot />
  </div>
</div>

<script>
  /**
   * Client-side admin guard.
   *
   * The Astro template ships with three panels (checking / forbidden /
   * ready) and the actual role check happens here, after hydration. We
   * read the persisted user record from the auth store and toggle the
   * matching panel via [data-admin-guard-status] selectors.
   *
   * Why an Astro guard at all? Each /admin/*.astro page wraps its
   * React island in <AdminGuard>, so we can ship a static SSR shell
   * without rendering protected content for unauthenticated visitors.
   */
  import { $user, isAdmin } from "../../store/authStore";

  const root = document.querySelector<HTMLElement>("[data-admin-guard]");
  if (root) {
    const panels = {
      checking: root.querySelector<HTMLElement>(
        '[data-admin-guard-status="checking"]',
      ),
      forbidden: root.querySelector<HTMLElement>(
        '[data-admin-guard-status="forbidden"]',
      ),
      ready: root.querySelector<HTMLElement>(
        '[data-admin-guard-status="ready"]',
      ),
    } as const;

    function applyVisibility(active: "checking" | "forbidden" | "ready"): void {
      (Object.keys(panels) as Array<keyof typeof panels>).forEach((key) => {
        const el = panels[key];
        if (!el) return;
        el.classList.toggle("hidden", key !== active);
      });
    }

    function resolve(): void {
      const user = $user.get();
      if (!user) {
        // Not signed in — bounce to /login so the user can authenticate.
        window.location.replace("/login");
        return;
      }
      if (!isAdmin()) {
        applyVisibility("forbidden");
        return;
      }
      applyVisibility("ready");
    }

    // Resolve once on mount and re-resolve whenever the persisted user
    // changes (e.g. after login on another tab or after a 401 logout).
    resolve();
    $user.listen(() => resolve());
  }
</script>

<style>
  .admin-guard {
    width: 100%;
  }
  .admin-guard__checking {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 4rem 1.5rem;
    color: hsl(var(--text-muted));
  }
  .admin-guard__spinner {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    border: 2.5px solid hsl(var(--surface-3));
    border-top-color: hsl(160 84% 39%);
    animation: admin-guard-spin 0.9s linear infinite;
  }
  .admin-guard__checking-label {
    font-size: 0.875rem;
    font-weight: 500;
  }
  @keyframes admin-guard-spin {
    to { transform: rotate(360deg); }
  }

  .admin-guard__forbidden {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 4rem 1.5rem;
    text-align: center;
    background-color: hsl(var(--surface-1));
    border: 1px solid hsl(var(--surface-3));
    border-radius: 1rem;
    max-width: 32rem;
    margin: 3rem auto;
  }
  .admin-guard__forbidden-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background-color: hsl(0 84% 95%);
    color: hsl(0 84% 45%);
    margin-bottom: 0.5rem;
  }
  .dark .admin-guard__forbidden-icon {
    background-color: hsl(0 84% 60% / 0.12);
    color: hsl(0 84% 70%);
  }
  .admin-guard__forbidden-icon svg {
    width: 1.85rem;
    height: 1.85rem;
  }
  .admin-guard__forbidden-title {
    font-family: "Outfit", "Inter", sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: hsl(var(--text-strong));
    margin: 0;
  }
  .admin-guard__forbidden-desc {
    color: hsl(var(--text-muted));
    font-size: 0.95rem;
    max-width: 28rem;
    margin: 0;
  }
  .admin-guard__forbidden-cta {
    margin-top: 1.25rem;
    padding: 0.55rem 1.4rem;
    border-radius: 0.625rem;
    background-color: hsl(160 84% 39%);
    color: white;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .admin-guard__forbidden-cta:hover {
    background-color: hsl(160 84% 32%);
  }
</style>
