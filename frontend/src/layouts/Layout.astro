---
// Master layout for SpotSync.
//
// Responsibilities:
//   1. HTML boilerplate + Google Fonts (Inter / Outfit) + global CSS import.
//   2. Inject a small pre-paint script that adds `.dark` to <html> BEFORE
//      the body renders, so the page never flashes the wrong theme.
//   3. Slot for page content.
//   4. Toast container + global toast helper.

import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "SpotSync — Smart Parking & EV Charging", description = "SpotSync is a modern parking and EV charging reservation platform." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {/* Pre-paint theme bootstrap.
        Runs synchronously in <head> so the .dark class is on <html> before
        the first paint — this avoids the flash of wrong theme (FOWT). The
        same logic is shared with `src/store/themeStore.ts` so toggles from
        the navbar stay consistent. */}
    <script is:inline>
      (function () {
        try {
          var stored = window.localStorage.getItem("spotsync_theme");
          var theme = stored === "light" || stored === "dark"
            ? stored
            : (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "dark");
          var root = document.documentElement;
          if (theme === "dark") {
            root.classList.add("dark");
          } else {
            root.classList.remove("dark");
          }
          root.style.colorScheme = theme;
        } catch (e) {
          // Defensive: if anything throws (SSR, broken storage), default to dark.
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen text-slate-900 dark:text-slate-100 font-sans antialiased bg-background">
    <Navbar pathname={Astro.url.pathname} />
    <slot />

    <!-- Toast notification container -->
    <div id="toast-container" aria-live="polite" aria-atomic="true"></div>

    <script>
      // Lightweight global toast helper exposed as window.showToast.
      type ToastType = "success" | "error" | "info";
      function showToast(message: string, type: ToastType = "info", duration = 3500) {
        const container = document.getElementById("toast-container");
        if (!container) return;

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;
        toast.textContent = message;
        container.appendChild(toast);

        window.setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transition = "opacity 0.3s ease";
          window.setTimeout(() => toast.remove(), 300);
        }, duration);
      }

      (window as unknown as { showToast: typeof showToast }).showToast = showToast;
    </script>
  </body>
</html>
