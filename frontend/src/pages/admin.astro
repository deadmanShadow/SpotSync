---
// Admin Dashboard (`/admin`).
//
// This page is the operational nerve center for SpotSync admins. It is
// statically rendered by Astro, then hydrated client-side to:
//   1. Auth-guard: redirects unauthenticated visitors to /login and
//      non-admin users back to /.
//   2. Fetch every zone + every reservation via the API services.
//   3. Render KPI analytics (Total Zones, EV Capacity, Active Bookings,
//      Available Spots, etc.).
//   4. Render a zone management grid with per-zone capacity bars.
//   5. Embed the `AdminReservationTable` for the global bookings monitor.
//   6. Embed the `CreateZoneModal` triggered by `data-open-create-zone`.
//
// Design notes:
//   - Uses Tailwind utility classes + the `.glass-card`/`.btn-*` helpers
//     defined in `src/styles/global.css` to stay consistent with the rest
//     of the SpotSync UI.
//   - Every script block imports typed modules so there is no `any`.
//   - Heavy inline logic was extracted into the embedded subcomponents
//     (`CreateZoneModal`, `AdminReservationTable`) which encapsulate their
//     own scripts.

import Layout from "@/layouts/Layout.astro";
import CreateZoneModal from "@/components/CreateZoneModal.astro";
import AdminReservationTable from "@/components/AdminReservationTable.astro";
---

<Layout
  title="Admin Dashboard — SpotSync"
  description="Manage parking zones, monitor live capacity, and oversee every SpotSync reservation in real time."
>
  <main class="relative container mx-auto px-4 py-10 max-w-7xl">
    <!-- ============================== AMBIENT GLOW ============================== -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-32 left-1/4 -translate-x-1/2 w-[42rem] h-[42rem] rounded-full bg-emerald-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/3 right-0 w-[28rem] h-[28rem] rounded-full bg-blue-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/3 w-[24rem] h-[24rem] rounded-full bg-purple-500/5 blur-3xl"
      >
      </div>
    </div>

    <!-- ============================== HEADER ============================== -->
    <header class="mb-10">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="min-w-0">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-emerald-500/10 text-emerald-300 border border-emerald-500/30"
            >
              <span
                class="relative w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-emerald-400/60 shadow-sm"
                aria-hidden="true"
              >
                <span
                  class="absolute inset-0 rounded-full bg-emerald-400 animate-ping opacity-75"
                ></span>
              </span>
              System Online
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-amber-500/10 text-amber-300 border border-amber-500/30"
              data-header-role
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Administrator
            </span>
          </div>
          <h1
            class="font-display text-4xl md:text-5xl font-bold text-slate-50 leading-tight tracking-tight"
          >
            <span class="text-gradient-brand">Admin</span> Dashboard
          </h1>
          <p class="text-slate-400 mt-3 max-w-2xl">
            Oversee the entire SpotSync network. Create new parking zones,
            monitor live capacity, and inspect every driver reservation
            from a single command center.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-action="refresh-all"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-slate-800/60 hover:bg-slate-700/80 text-slate-100 border border-slate-700/80 hover:border-slate-600 transition-all shadow-sm hover:shadow-md"
            aria-label="Refresh dashboard data"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true" data-refresh-icon>
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            Refresh
          </button>
          <button
            type="button"
            data-open-create-zone
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:from-emerald-400 hover:to-emerald-500 transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
              <path d="M12 5v14"></path><path d="M5 12h14"></path>
            </svg>
            Add New Zone
          </button>
        </div>
      </div>
    </header>

    <!-- ============================== KPI STRIP ============================== -->
    <section
      class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10"
      aria-label="System analytics"
      data-kpi-section
    >
      <!-- Total Zones -->
      <div
        class="relative overflow-hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-black/20 transition-all hover:border-slate-700"
        data-kpi-card="zones"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-slate-500/10 blur-2xl"
          aria-hidden="true"
        ></div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-400 font-bold">
            Total Zones
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-slate-50" data-kpi-zones>
          <span class="inline-block w-12 h-8 bg-slate-800/60 rounded animate-pulse"></span>
        </p>
        <p class="relative mt-1 text-xs text-slate-500">
          <span data-kpi-zones-ev>—</span> EV charging hubs
        </p>
      </div>

      <!-- EV Capacity -->
      <div
        class="relative overflow-hidden rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-emerald-950/40 to-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-emerald-500/10 transition-all hover:border-emerald-400/60 hover:shadow-emerald-500/20"
        data-kpi-card="ev"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-emerald-500/20 blur-2xl"
          aria-hidden="true"
        ></div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-emerald-300 font-bold">
            EV Capacity
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-emerald-200" data-kpi-ev>
          <span class="inline-block w-12 h-8 bg-emerald-500/15 rounded animate-pulse"></span>
        </p>
        <p class="relative mt-1 text-xs text-emerald-300/80">
          <span data-kpi-ev-available>—</span> EV chargers free
        </p>
      </div>

      <!-- Active Bookings -->
      <div
        class="relative overflow-hidden rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-950/40 to-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-blue-500/10 transition-all hover:border-blue-400/60 hover:shadow-blue-500/20"
        data-kpi-card="bookings"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-blue-500/20 blur-2xl"
          aria-hidden="true"
        ></div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-blue-300 font-bold">
            Active Bookings
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-blue-500/15 border border-blue-400/30 flex items-center justify-center text-blue-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-blue-200" data-kpi-bookings>
          <span class="inline-block w-12 h-8 bg-blue-500/15 rounded animate-pulse"></span>
        </p>
        <p class="relative mt-1 text-xs text-blue-300/80">
          <span data-kpi-bookings-cancelled>—</span> cancelled lifetime
        </p>
      </div>

      <!-- Available Spots -->
      <div
        class="relative overflow-hidden rounded-2xl border border-purple-500/30 bg-gradient-to-br from-purple-950/40 to-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-purple-500/10 transition-all hover:border-purple-400/60 hover:shadow-purple-500/20"
        data-kpi-card="available"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-purple-500/20 blur-2xl"
          aria-hidden="true"
        ></div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-purple-300 font-bold">
            Available Spots
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-purple-500/15 border border-purple-400/30 flex items-center justify-center text-purple-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-purple-200" data-kpi-available>
          <span class="inline-block w-12 h-8 bg-purple-500/15 rounded animate-pulse"></span>
        </p>
        <p class="relative mt-1 text-xs text-purple-300/80">
          <span data-kpi-occupancy>—</span>% network occupancy
        </p>
      </div>
    </section>

    <!-- ============================== RECENT DRIVER BOOKINGS ============================== -->
    <section class="mb-10" aria-label="Recent driver bookings">
      <div class="flex items-end justify-between gap-4 mb-5 flex-wrap">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-flex w-1 h-6 rounded-full bg-gradient-to-b from-emerald-400 to-blue-500"></span>
            <h2 class="font-display text-2xl font-bold text-slate-50">
              Recent Driver Bookings
            </h2>
          </div>
          <p class="text-sm text-slate-400 ml-3">
            Every reservation across the network — sorted newest first.
            Auto-refreshes every 15 seconds.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-slate-800/60 text-slate-300 border border-slate-700/60"
            data-bookings-last-updated
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" data-bookings-pulse aria-hidden="true"></span>
            <span data-bookings-updated-label>Live</span>
          </span>
        </div>
      </div>

      <!-- Loading skeleton -->
      <div
        class="glass-card overflow-hidden"
        data-bookings-skeleton
        aria-hidden="true"
      >
        <div class="p-5 border-b border-slate-800/80">
          <div class="h-5 w-56 bg-slate-800/60 rounded animate-pulse"></div>
          <div class="h-3 w-72 bg-slate-800/60 rounded mt-2 animate-pulse"></div>
        </div>
        <div class="p-3 space-y-2">
          {Array.from({ length: 5 }).map(() => (
            <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/40">
              <div class="w-10 h-10 rounded-xl bg-slate-800/60 animate-pulse"></div>
              <div class="flex-1 space-y-2">
                <div class="h-3 w-32 bg-slate-800/60 rounded animate-pulse"></div>
                <div class="h-2 w-48 bg-slate-800/40 rounded animate-pulse"></div>
              </div>
              <div class="h-6 w-16 bg-slate-800/60 rounded animate-pulse"></div>
            </div>
          ))}
        </div>
      </div>

      <!-- Error state -->
      <div
        class="hidden rounded-2xl border border-red-500/30 bg-red-950/20 backdrop-blur-md p-10 text-center shadow-xl shadow-red-500/10"
        data-bookings-error
        role="alert"
      >
        <div
          class="w-16 h-16 mx-auto rounded-2xl bg-red-500/15 border border-red-500/30 flex items-center justify-center mb-4"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-red-300">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h2 class="font-display text-xl font-bold text-slate-50">
          Couldn't load recent bookings
        </h2>
        <p class="text-slate-400 mt-2 max-w-md mx-auto" data-bookings-error-message>
          Please try again in a moment.
        </p>
        <button
          type="button"
          class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:from-blue-400 hover:to-blue-500 transition-all"
          data-action="retry-bookings"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          Try Again
        </button>
      </div>

      <!-- Empty state -->
      <div
        class="hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-12 text-center shadow-xl shadow-black/20"
        data-bookings-empty
        role="status"
      >
        <div
          class="w-24 h-24 mx-auto rounded-3xl bg-gradient-to-br from-emerald-500/20 via-blue-500/10 to-purple-500/15 border border-slate-700/60 flex items-center justify-center mb-6 shadow-inner"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-emerald-300">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h2 class="font-display text-2xl font-bold text-slate-50">
          No bookings yet
        </h2>
        <p class="text-slate-400 mt-2 max-w-md mx-auto">
          When drivers reserve parking or EV charging spots, every
          booking will appear here in real time.
        </p>
      </div>

      <!-- Booking list (rendered by client script) -->
      <div
        class="hidden glass-card overflow-hidden"
        data-bookings-list-wrapper
        aria-live="polite"
      >
        <ul
          class="divide-y divide-slate-800/80"
          data-bookings-list
          role="list"
        >
        </ul>
      </div>
    </section>

    <!-- ============================== ZONE MANAGEMENT ============================== -->
    <section class="mb-10" aria-label="Zone management">
      <div class="flex items-end justify-between gap-4 mb-5 flex-wrap">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-flex w-1 h-6 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600"></span>
            <h2 class="font-display text-2xl font-bold text-slate-50">
              Parking Zone Management
            </h2>
          </div>
          <p class="text-sm text-slate-400 ml-3">
            Create, audit, and monitor every parking zone in the network.
          </p>
        </div>
        <button
          type="button"
          data-open-create-zone
          class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800/60 hover:bg-slate-700/80 text-slate-100 border border-slate-700/80 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true">
            <path d="M12 5v14"></path><path d="M5 12h14"></path>
          </svg>
          New Zone
        </button>
      </div>

      <!-- Loading skeleton -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
        data-zone-skeleton
        aria-hidden="true"
      >
        {Array.from({ length: 3 }).map((_, i) => (
          <div
            class="rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-black/20 overflow-hidden"
            style={`animation-delay: ${i * 80}ms`}
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-800/60 animate-pulse"></div>
              <div class="flex-1 space-y-2">
                <div class="h-2 w-16 bg-slate-800/60 rounded animate-pulse"></div>
                <div class="h-3 w-32 bg-slate-800/60 rounded animate-pulse"></div>
              </div>
            </div>
            <div class="h-12 bg-slate-800/40 rounded-xl mt-4 animate-pulse"></div>
            <div class="flex justify-between mt-4">
              <div class="h-8 w-24 bg-slate-800/60 rounded-lg animate-pulse"></div>
              <div class="h-4 w-16 bg-slate-800/60 rounded animate-pulse"></div>
            </div>
          </div>
        ))}
      </div>

      <!-- Zone grid (filled by client script) -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 hidden"
        data-zone-grid
        aria-live="polite"
      >
      </div>

      <!-- Empty state -->
      <div
        class="hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-12 text-center shadow-xl shadow-black/20"
        data-zone-empty
        role="status"
      >
        <div
          class="w-24 h-24 mx-auto rounded-3xl bg-gradient-to-br from-emerald-500/20 via-blue-500/10 to-purple-500/15 border border-slate-700/60 flex items-center justify-center mb-6 shadow-inner"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-emerald-300">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </div>
        <h2 class="font-display text-2xl font-bold text-slate-50">
          No zones configured yet
        </h2>
        <p class="text-slate-400 mt-2 max-w-md mx-auto">
          Get the SpotSync network started by creating your first
          parking zone. Drivers will be able to reserve spots immediately.
        </p>
        <button
          type="button"
          data-open-create-zone
          class="mt-6 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:from-emerald-400 hover:to-emerald-500 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <path d="M12 5v14"></path><path d="M5 12h14"></path>
          </svg>
          Create First Zone
        </button>
      </div>

      <!-- Error state -->
      <div
        class="hidden rounded-2xl border border-red-500/30 bg-red-950/20 backdrop-blur-md p-10 text-center shadow-xl shadow-red-500/10"
        data-zone-error
        role="alert"
      >
        <div
          class="w-16 h-16 mx-auto rounded-2xl bg-red-500/15 border border-red-500/30 flex items-center justify-center mb-4"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-red-300">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h2 class="font-display text-xl font-bold text-slate-50">
          Couldn't load zones
        </h2>
        <p class="text-slate-400 mt-2 max-w-md mx-auto" data-zone-error-message>
          Please try again in a moment.
        </p>
        <button
          type="button"
          class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:from-blue-400 hover:to-blue-500 transition-all"
          data-action="retry-zones"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          Try Again
        </button>
      </div>
    </section>

    <!-- ============================== SYSTEM RESERVATIONS MONITOR ============================== -->
    <section class="mb-10" aria-label="System reservation monitor">
      <div class="flex items-end justify-between gap-4 mb-5 flex-wrap">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-flex w-1 h-6 rounded-full bg-gradient-to-b from-blue-400 to-blue-600"></span>
            <h2 class="font-display text-2xl font-bold text-slate-50">
              Global Reservations
            </h2>
          </div>
          <p class="text-sm text-slate-400 ml-3">
            Every driver booking across the network — active, cancelled,
            and historical.
          </p>
        </div>
      </div>

      <!-- Loading skeleton -->
      <div
        class="glass-card overflow-hidden"
        data-reservation-skeleton
        aria-hidden="true"
      >
        <div class="p-5 border-b border-slate-800/80">
          <div class="h-5 w-48 bg-slate-800/60 rounded animate-pulse"></div>
          <div class="h-3 w-72 bg-slate-800/60 rounded mt-2 animate-pulse"></div>
        </div>
        <div class="p-5 space-y-3">
          {Array.from({ length: 4 }).map(() => (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-800/60 animate-pulse"></div>
              <div class="flex-1 space-y-2">
                <div class="h-3 w-32 bg-slate-800/60 rounded animate-pulse"></div>
                <div class="h-2 w-48 bg-slate-800/40 rounded animate-pulse"></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Real monitor (hidden until populated) -->
      <div class="hidden" data-reservation-table-wrapper>
        <AdminReservationTable />
      </div>

      <!-- Error state -->
      <div
        class="hidden rounded-2xl border border-red-500/30 bg-red-950/20 backdrop-blur-md p-10 text-center shadow-xl shadow-red-500/10"
        data-reservation-error
        role="alert"
      >
        <div
          class="w-16 h-16 mx-auto rounded-2xl bg-red-500/15 border border-red-500/30 flex items-center justify-center mb-4"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-red-300">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h2 class="font-display text-xl font-bold text-slate-50">
          Couldn't load reservations
        </h2>
        <p class="text-slate-400 mt-2 max-w-md mx-auto" data-reservation-error-message>
          Please try again in a moment.
        </p>
        <button
          type="button"
          class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:from-blue-400 hover:to-blue-500 transition-all"
          data-action="retry-reservations"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          Try Again
        </button>
      </div>
    </section>

    <!-- ============================== AUTH FORBIDDEN SCREEN ============================== -->
    <section
      class="hidden rounded-2xl border border-red-500/30 bg-red-950/20 backdrop-blur-md p-12 text-center shadow-xl shadow-red-500/10"
      data-auth-forbidden
      role="alert"
    >
      <div
        class="w-24 h-24 mx-auto rounded-3xl bg-red-500/15 border border-red-500/30 flex items-center justify-center mb-6 shadow-inner"
        aria-hidden="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-red-300">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2 class="font-display text-2xl font-bold text-slate-50">
        Administrator access required
      </h2>
      <p class="text-slate-400 mt-2 max-w-md mx-auto">
        Your account doesn't have administrator privileges. If you believe
        this is a mistake, contact a SpotSync super-admin.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:from-blue-400 hover:to-blue-500 transition-all"
      >
        Return Home
      </a>
    </section>

    <!-- Create Zone Modal -->
    <CreateZoneModal />
  </main>
</Layout>

<script>
  // Admin dashboard controller.
  //
  // Responsibilities:
  //   1. Auth + role guard.
  //   2. Fetch zones + reservations from the API services.
  //   3. Compute KPI metrics (Total Zones, EV Capacity, Active Bookings,
  //      Available Spots, Occupancy %).
  //   4. Render the zone management grid with per-zone capacity bars.
  //   5. Populate the AdminReservationTable via its script tag.
  //   6. Refresh button + retry actions + zone-creation event listener
  //      (so creating a zone via the modal instantly refreshes KPIs).
  //
  // Strict TypeScript throughout — no `any`, no `as unknown as T`.

  import { getUser, isAdmin, isAuthenticated } from "../store/authStore";
  import { ApiError } from "../services/api";
  import { getZones } from "../services/zoneService";
  import { getAllReservations } from "../services/reservationService";
  import type { ParkingZone, ZoneType } from "../types/zone";
  import type { Reservation } from "../types/reservation";
  import type { User } from "../types/auth";

  // ---------------------------------------------------------------------------
  // Auth guard
  // ---------------------------------------------------------------------------

  const user: User | null = guardAuth();

  function guardAuth(): User | null {
    if (!isAuthenticated()) {
      window.location.replace("/login");
      return null;
    }
    const u = getUser();
    if (!u) {
      window.location.replace("/login");
      return null;
    }
    if (!isAdmin()) {
      // Hide everything and show the forbidden panel.
      const main = document.querySelector<HTMLElement>("main");
      const forbidden = document.querySelector<HTMLElement>("[data-auth-forbidden]");
      if (main) {
        main.querySelectorAll<HTMLElement>("section, header").forEach((el) => {
          if (el.closest("[data-auth-forbidden]")) return;
          el.classList.add("hidden");
        });
      }
      forbidden?.classList.remove("hidden");
      // Bounce non-admins back to home after a short delay so they can read
      // the message.
      window.setTimeout(() => {
        window.location.replace("/");
      }, 2500);
      return null;
    }
    return u;
  }

  // ---------------------------------------------------------------------------
  // Component-scoped state
  // ---------------------------------------------------------------------------

  let allZones: ParkingZone[] = [];
  let allReservations: Reservation[] = [];
  let isLoadingZones = false;
  let isLoadingReservations = false;

  // ---------------------------------------------------------------------------
  // Helpers
  // ---------------------------------------------------------------------------

  function escapeHtml(input: string): string {
    return input
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function showZoneSection(name: "skeleton" | "grid" | "empty" | "error"): void {
    const map = {
      skeleton: document.querySelector<HTMLElement>("[data-zone-skeleton]"),
      grid: document.querySelector<HTMLElement>("[data-zone-grid]"),
      empty: document.querySelector<HTMLElement>("[data-zone-empty]"),
      error: document.querySelector<HTMLElement>("[data-zone-error]"),
    } as const;
    for (const [key, el] of Object.entries(map)) {
      if (!el) continue;
      el.classList.toggle("hidden", key !== name);
    }
  }

  function showReservationSection(
    name: "skeleton" | "table" | "error",
  ): void {
    const map = {
      skeleton: document.querySelector<HTMLElement>("[data-reservation-skeleton]"),
      table: document.querySelector<HTMLElement>("[data-reservation-table-wrapper]"),
      error: document.querySelector<HTMLElement>("[data-reservation-error]"),
    } as const;
    for (const [key, el] of Object.entries(map)) {
      if (!el) continue;
      el.classList.toggle("hidden", key !== name);
    }
  }

  function showBookingsSection(
    name: "skeleton" | "list" | "empty" | "error",
  ): void {
    const map = {
      skeleton: document.querySelector<HTMLElement>("[data-bookings-skeleton]"),
      list: document.querySelector<HTMLElement>("[data-bookings-list-wrapper]"),
      empty: document.querySelector<HTMLElement>("[data-bookings-empty]"),
      error: document.querySelector<HTMLElement>("[data-bookings-error]"),
    } as const;
    for (const [key, el] of Object.entries(map)) {
      if (!el) continue;
      el.classList.toggle("hidden", key !== name);
    }
  }

  // ---------------------------------------------------------------------------
  // Recent Driver Bookings — rich list with full driver info + formatted dates
  // ---------------------------------------------------------------------------

  /** Short month names used by `formatReservationDateTime`. */
  const MONTHS = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
  ] as const;

  /**
   * Format an ISO timestamp as `8-Aug-2026 15:38` (locale-independent).
   * Returns the raw ISO string as a graceful fallback when the input is
   * not a valid Date so we never display "Invalid Date".
   */
  function formatReservationDateTime(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    const day = d.getDate();
    const month = MONTHS[d.getMonth()];
    const year = d.getFullYear();
    const hh = String(d.getHours()).padStart(2, "0");
    const mm = String(d.getMinutes()).padStart(2, "0");
    return `${day}-${month}-${year} ${hh}:${mm}`;
  }

  const STATUS_PILL_NEW: Record<
    Reservation["status"],
    { label: string; classes: string; dot: string }
  > = {
    active: {
      label: "Active",
      classes: "border-emerald-400/40 bg-emerald-500/15 text-emerald-300",
      dot: "bg-emerald-400",
    },
    completed: {
      label: "Completed",
      classes: "border-blue-400/30 bg-blue-500/15 text-blue-300",
      dot: "bg-blue-400",
    },
    cancelled: {
      label: "Cancelled",
      classes: "border-slate-500/40 bg-slate-700/40 text-slate-300",
      dot: "bg-slate-400",
    },
  };

  const TYPE_CHIP_NEW: Record<ZoneType, string> = {
    ev_charging: "border-emerald-400/30 bg-emerald-500/15 text-emerald-300",
    general: "border-blue-400/30 bg-blue-500/15 text-blue-300",
    covered: "border-purple-400/30 bg-purple-500/15 text-purple-300",
  };

  function initialsOf(name: string, email: string): string {
    const source = (name || email || "").trim();
    if (!source) return "?";
    return source
      .split(/\s+|@|\./)
      .filter((part) => part.length > 0)
      .map((part) => part.charAt(0).toUpperCase())
      .slice(0, 2)
      .join("");
  }

  function renderBookingRow(reservation: Reservation): string {
    const driverEmail = reservation.user?.email ?? `user#${reservation.user_id}`;
    const driverName = reservation.user?.name ?? "";
    const initials = initialsOf(driverName, driverEmail);
    const zoneName = reservation.zone?.name ?? `Zone #${reservation.zone_id}`;
    const zoneType: ZoneType = reservation.zone?.type ?? "general";
    const plate = (reservation.license_plate ?? "").trim() || "—";
    const status = reservation.status;
    const pill = STATUS_PILL_NEW[status] ?? STATUS_PILL_NEW.cancelled;
    const chip = TYPE_CHIP_NEW[zoneType];
    const formatted = formatReservationDateTime(reservation.created_at);
    const iso = reservation.created_at;
    const reservationId = reservation.id;

    return `
      <li
        class="group px-5 py-4 transition hover:bg-slate-900/40 animate-fade-in-up"
        data-booking-row
        data-booking-status="${status}"
      >
        <div class="flex items-start gap-4 flex-wrap">
          <!-- Driver avatar + identity -->
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500/80 to-blue-500/80 flex items-center justify-center text-white text-sm font-bold shadow-inner" aria-hidden="true">
              ${escapeHtml(initials)}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-50 truncate">
                ${escapeHtml(driverName || driverEmail)}
              </p>
              <p class="text-xs text-slate-400 truncate" title="${escapeHtml(driverEmail)}">
                ${escapeHtml(driverEmail)}
              </p>
            </div>
          </div>

          <!-- Zone + type -->
          <div class="min-w-0 flex-1">
            <p class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-500 font-bold mb-0.5">
              Zone
            </p>
            <p class="text-sm font-semibold text-slate-100 truncate">${escapeHtml(zoneName)}</p>
            <span class="mt-1 inline-flex items-center rounded-md border px-2 py-0.5 text-[0.65rem] font-semibold ${chip}">
              ${zoneType === "ev_charging" ? "EV" : zoneType === "covered" ? "Covered" : "General"}
            </span>
          </div>

          <!-- Spot / Plate -->
          <div class="min-w-[7rem]">
            <p class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-500 font-bold mb-0.5">
              Spot #${escapeHtml(String(reservationId))}
            </p>
            <span class="inline-flex items-center rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-1 font-mono text-xs font-bold tracking-widest text-slate-100">
              ${escapeHtml(plate)}
            </span>
          </div>

          <!-- Date + time -->
          <div class="min-w-[10rem]">
            <p class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-500 font-bold mb-0.5">
              Booked at
            </p>
            <p class="text-sm font-mono font-semibold text-slate-100">${escapeHtml(formatted)}</p>
            <p class="text-[0.65rem] text-slate-500 font-mono">${escapeHtml(iso)}</p>
          </div>

          <!-- Status -->
          <div class="min-w-[6rem] flex justify-end">
            <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold ${pill.classes}">
              <span class="h-1.5 w-1.5 rounded-full ${pill.dot}" aria-hidden="true"></span>
              ${pill.label}
            </span>
          </div>
        </div>
      </li>
    `;
  }

  function paintBookings(): void {
    const list = document.querySelector<HTMLElement>("[data-bookings-list]");
    const updatedLabel = document.querySelector<HTMLElement>(
      "[data-bookings-updated-label]",
    );
    if (!list) return;

    if (allReservations.length === 0) {
      showBookingsSection("empty");
      return;
    }

    const sorted = [...allReservations].sort(
      (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
    );

    list.innerHTML = sorted.map(renderBookingRow).join("");
    showBookingsSection("list");

    if (updatedLabel) {
      const now = new Date();
      updatedLabel.textContent = `Updated ${formatReservationDateTime(now.toISOString())}`;
    }
  }

  async function loadBookings(): Promise<void> {
    // First load: show skeleton. Subsequent loads (polling) keep the list
    // visible and just swap in the new data silently.
    if (allReservations.length === 0) showBookingsSection("skeleton");
    try {
      const list = await getAllReservations();
      allReservations = Array.isArray(list) ? list : [];

      // The same payload also feeds the existing AdminReservationTable
      // and the KPI counters, so keep those in sync.
      paintBookings();
      paintReservations();
      paintKpis();
    } catch (error) {
      const message =
        error instanceof ApiError && error.status === 401
          ? "Your session has expired. Please sign in again."
          : error instanceof ApiError
          ? error.message
          : "We couldn't reach the SpotSync server.";
      const errEl = document.querySelector<HTMLElement>(
        "[data-bookings-error-message]",
      );
      if (errEl) errEl.textContent = message;
      // Only show the error panel if we have nothing else to show.
      if (allReservations.length === 0) {
        showBookingsSection("error");
      }
      if (error instanceof ApiError && error.status === 401) {
        window.setTimeout(() => window.location.replace("/login"), 1200);
      }
    }
  }

  function bindRetryBookings(): void {
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const button = target.closest<HTMLButtonElement>(
        "[data-action='retry-bookings']",
      );
      if (!button) return;
      event.preventDefault();
      void loadBookings();
    });
  }

  function showToast(
    message: string,
    type: "success" | "error" | "info" = "info",
  ): void {
    const w = window as unknown as {
      showToast?: (message: string, type?: string) => void;
    };
    if (typeof w.showToast === "function") {
      w.showToast(message, type);
    }
  }

  // ---------------------------------------------------------------------------
  // Zone rendering
  // ---------------------------------------------------------------------------

  const TYPE_BADGE: Record<ZoneType, { label: string; classes: string; icon: string }> = {
    ev_charging: {
      label: "EV Charging",
      classes: "border-emerald-400/30 bg-emerald-500/10 text-emerald-300",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
    },
    general: {
      label: "General",
      classes: "border-blue-400/30 bg-blue-500/10 text-blue-300",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg>`,
    },
    covered: {
      label: "Covered",
      classes: "border-purple-400/30 bg-purple-500/10 text-purple-300",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>`,
    },
  };

  function pickBarColor(fillPercent: number, available: number): {
    color: string;
    shadow: string;
    label: string;
  } {
    if (available <= 0) {
      return { color: "bg-red-500", shadow: "shadow-red-500/40", label: "Full" };
    }
    if (fillPercent < 20) {
      return {
        color: "bg-red-500",
        shadow: "shadow-red-500/40",
        label: "Almost Full",
      };
    }
    if (fillPercent < 50) {
      return {
        color: "bg-amber-500",
        shadow: "shadow-amber-500/40",
        label: "Filling Up",
      };
    }
    return {
      color: "bg-emerald-500",
      shadow: "shadow-emerald-500/40",
      label: "Open",
    };
  }

  function renderZoneCard(zone: ParkingZone): string {
    const total = Math.max(0, zone.total_capacity);
    const available = Math.max(0, zone.available_spots);
    const occupied = Math.max(0, total - available);
    const fillPercent = total === 0 ? 0 : Math.min(100, (available / total) * 100);
    const bar = pickBarColor(fillPercent, available);
    const badge = TYPE_BADGE[zone.type] ?? TYPE_BADGE.general;
    const price = zone.price_per_hour.toFixed(2);

    return `
      <article
        class="group relative overflow-hidden rounded-2xl border border-slate-800/80 bg-slate-900/70 backdrop-blur-md shadow-xl shadow-black/20 p-5 transition-all duration-300 hover:border-slate-700 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-black/40 animate-fade-in-up"
        data-zone-card
        data-zone-id="${zone.id}"
        data-zone-type="${zone.type}"
      >
        <header class="flex items-start justify-between gap-3 mb-3">
          <div class="min-w-0">
            <p class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-500 font-bold mb-1">
              Zone #${zone.id}
            </p>
            <h3 class="font-display text-lg font-bold text-slate-50 leading-tight truncate">
              ${escapeHtml(zone.name)}
            </h3>
          </div>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold border whitespace-nowrap ${badge.classes}"
          >
            ${badge.icon}
            ${badge.label}
          </span>
        </header>

        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-800/60 border border-slate-700/60 text-xs font-semibold text-slate-100">
            $${price}/hr
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${
            bar.label === "Full"
              ? "bg-red-500/10 text-red-300 border border-red-500/30"
              : bar.label === "Almost Full"
              ? "bg-red-500/10 text-red-300 border border-red-500/30"
              : bar.label === "Filling Up"
              ? "bg-amber-500/10 text-amber-300 border border-amber-500/30"
              : "bg-emerald-500/10 text-emerald-300 border border-emerald-500/30"
          }">
            ${bar.label}
          </span>
        </div>

        <div class="space-y-2 mb-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400">
              <span class="font-bold text-slate-100">${available}</span>
              of
              <span class="font-semibold text-slate-200">${total}</span>
              available
            </span>
            <span class="text-slate-500">${Math.round(fillPercent)}%</span>
          </div>
          <div class="h-2 w-full bg-slate-800/80 rounded-full overflow-hidden border border-slate-700/50">
            <div
              class="h-full rounded-full transition-all duration-500 shadow-lg ${bar.color} ${bar.shadow}"
              style="width: ${fillPercent}%"
            ></div>
          </div>
        </div>

        <footer class="flex items-center justify-between gap-2 pt-3 mt-2 border-t border-slate-800/80">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-500 font-bold">
            Occupied
          </span>
          <span class="text-xs font-semibold text-slate-200">
            ${occupied} / ${total} spots
          </span>
        </footer>
      </article>
    `;
  }

  function paintZones(): void {
    const grid = document.querySelector<HTMLElement>("[data-zone-grid]");
    if (!grid) return;
    if (allZones.length === 0) {
      showZoneSection("empty");
      return;
    }
    const sorted = [...allZones].sort((a, b) => a.id - b.id);
    grid.innerHTML = sorted.map(renderZoneCard).join("");
    showZoneSection("grid");
  }

  // ---------------------------------------------------------------------------
  // KPI computation + painting
  // ---------------------------------------------------------------------------

  function paintKpis(): void {
    const totalZones = allZones.length;
    const evZones = allZones.filter((z) => z.type === "ev_charging");
    const evCapacity = evZones.reduce((sum, z) => sum + Math.max(0, z.total_capacity), 0);
    const evAvailable = evZones.reduce((sum, z) => sum + Math.max(0, z.available_spots), 0);

    const activeBookings = allReservations.filter(
      (r) => r.status === "active",
    ).length;
    const cancelledBookings = allReservations.filter(
      (r) => r.status === "cancelled" || r.status === "completed",
    ).length;

    const totalCapacity = allZones.reduce(
      (sum, z) => sum + Math.max(0, z.total_capacity),
      0,
    );
    const totalAvailable = allZones.reduce(
      (sum, z) => sum + Math.max(0, z.available_spots),
      0,
    );
    const totalOccupied = Math.max(0, totalCapacity - totalAvailable);
    const occupancyPct =
      totalCapacity === 0
        ? 0
        : Math.round((totalOccupied / totalCapacity) * 100);

    const set = (
      selector: string,
      value: string,
    ): void => {
      const el = document.querySelector<HTMLElement>(selector);
      if (el) el.textContent = value;
    };

    set("[data-kpi-zones]", String(totalZones));
    set("[data-kpi-zones-ev]", String(evZones.length));
    set("[data-kpi-ev]", String(evCapacity));
    set("[data-kpi-ev-available]", String(evAvailable));
    set("[data-kpi-bookings]", String(activeBookings));
    set("[data-kpi-bookings-cancelled]", String(cancelledBookings));
    set("[data-kpi-available]", String(totalAvailable));
    set("[data-kpi-occupancy]", `${occupancyPct}`);
  }

  // ---------------------------------------------------------------------------
  // Reservation table population
  // ---------------------------------------------------------------------------

  function paintReservations(): void {
    if (allReservations.length === 0) {
      // Still show the table — empty state is rendered inside the component.
      showReservationSection("table");
    } else {
      showReservationSection("table");
    }
    const node = document.querySelector<HTMLElement>("[data-all-reservations]");
    if (node) {
      node.textContent = JSON.stringify(allReservations);
    }
    // Tell the embedded AdminReservationTable to re-paint with new data.
    window.dispatchEvent(
      new CustomEvent<Reservation[]>("spotsync:reservations-updated", {
        detail: allReservations,
      }),
    );
  }

  // ---------------------------------------------------------------------------
  // Data loading
  // ---------------------------------------------------------------------------

  async function loadZones(): Promise<void> {
    if (isLoadingZones) return;
    isLoadingZones = true;
    if (allZones.length === 0) showZoneSection("skeleton");
    try {
      const list = await getZones();
      allZones = Array.isArray(list) ? list : [];
      paintZones();
      paintKpis();
    } catch (error) {
      const message =
        error instanceof ApiError && error.status === 401
          ? "Your session has expired. Please sign in again."
          : error instanceof ApiError
          ? error.message
          : "We couldn't reach the SpotSync server.";
      const errEl = document.querySelector<HTMLElement>("[data-zone-error-message]");
      if (errEl) errEl.textContent = message;
      showZoneSection("error");

      if (error instanceof ApiError && error.status === 401) {
        window.setTimeout(() => window.location.replace("/login"), 1200);
      }
    } finally {
      isLoadingZones = false;
    }
  }

  async function loadReservations(): Promise<void> {
    if (isLoadingReservations) return;
    isLoadingReservations = true;
    if (allReservations.length === 0) showReservationSection("skeleton");
    try {
      const list = await getAllReservations();
      allReservations = Array.isArray(list) ? list : [];
      paintReservations();
      paintKpis();
    } catch (error) {
      const message =
        error instanceof ApiError && error.status === 401
          ? "Your session has expired. Please sign in again."
          : error instanceof ApiError
          ? error.message
          : "We couldn't reach the SpotSync server.";
      const errEl = document.querySelector<HTMLElement>(
        "[data-reservation-error-message]",
      );
      if (errEl) errEl.textContent = message;
      showReservationSection("error");

      if (error instanceof ApiError && error.status === 401) {
        window.setTimeout(() => window.location.replace("/login"), 1200);
      }
    } finally {
      isLoadingReservations = false;
    }
  }

  /**
   * Lightweight near-real-time refresh — every 15 seconds we re-fetch the
   * reservation list from the backend so the admin sees new bookings
   * without having to refresh the page. This is the cross-browser
   * equivalent of a ~real-time push channel; the existing app architecture
   * does not include WebSocket/SSE, so polling is the correct primitive.
   */
  function startRealtimePolling(): void {
    const POLL_INTERVAL_MS = 15_000;
    window.setInterval(() => {
      void loadBookings();
    }, POLL_INTERVAL_MS);
  }

  // ---------------------------------------------------------------------------
  // Event bindings
  // ---------------------------------------------------------------------------

  function bindRefresh(): void {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-action='refresh-all']",
    );
    if (!button) return;
    button.addEventListener("click", () => {
      const icon = button.querySelector<HTMLElement>("[data-refresh-icon]");
      icon?.classList.add("animate-spin");
      Promise.all([loadZones(), loadBookings()]).finally(() => {
        icon?.classList.remove("animate-spin");
        showToast("Dashboard refreshed.", "success");
      });
    });
  }

  function bindRetryZones(): void {
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const button = target.closest<HTMLButtonElement>(
        "[data-action='retry-zones']",
      );
      if (!button) return;
      event.preventDefault();
      void loadZones();
    });
  }

  function bindRetryReservations(): void {
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const button = target.closest<HTMLButtonElement>(
        "[data-action='retry-reservations']",
      );
      if (!button) return;
      event.preventDefault();
      void loadReservations();
    });
  }

  /**
   * Listen for the `spotsync:zone-created` event fired by the
   * CreateZoneModal so newly created zones instantly populate the grid
   * and KPIs without forcing the admin to click Refresh.
   */
  function bindZoneCreatedListener(): void {
    window.addEventListener(
      "spotsync:zone-created",
      (event: Event) => {
        const detail = (event as CustomEvent<ParkingZone>).detail;
        if (detail && typeof detail === "object" && "id" in detail) {
          allZones.push(detail);
          paintZones();
          paintKpis();
        }
      },
    );
  }

  /**
   * When a driver cancels a reservation while an admin tab is open,
   * re-fetch everything so the global monitor + bookings list stay in sync.
   */
  function bindReservationCancelledListener(): void {
    window.addEventListener("spotsync:reservation-cancelled", () => {
      void Promise.all([loadZones(), loadBookings()]);
    });
  }

  // ---------------------------------------------------------------------------
  // Bootstrap (only when the user is an authenticated admin)
  // ---------------------------------------------------------------------------

  if (user && isAdmin()) {
    bindRefresh();
    bindRetryZones();
    bindRetryReservations();
    bindRetryBookings();
    bindZoneCreatedListener();
    bindReservationCancelledListener();
    void loadZones();
    void loadBookings();
    // Near-real-time updates — poll the backend every 15s.
    startRealtimePolling();
  }
</script>