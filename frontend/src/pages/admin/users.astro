---
/**
 * Admin > Users (/admin/users)
 *
 * Thin shell — the live React island handles the table, role filter,
 * and delete actions.
 */

import Layout from "@/layouts/Layout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminGuard from "@/components/admin/AdminGuard.astro";
import { UsersTable } from "@/components/admin/UsersTable";
---

<Layout
  title="Users — SpotSync Admin"
  description="Every registered user on SpotSync."
>
  <AdminGuard>
    <AdminSidebar
      title="Users"
      subtitle="Every registered user on SpotSync — drivers and administrators."
    >
      <UsersTable client:only="react" />
    </AdminSidebar>
  </AdminGuard>
</Layout>
