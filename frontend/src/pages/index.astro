---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="SpotSync — Smart Parking & EV Charging">
  <main class="container mx-auto px-4 py-20">
    <section class="text-center max-w-3xl mx-auto animate-fade-in">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse-glow"></span>
        Step 1 — Design System Online
      </span>
      <h1 class="font-display text-5xl md:text-6xl font-bold text-slate-50 mb-6 leading-tight">
        SpotSync
        <span class="text-gradient-brand"> Frontend</span>
      </h1>
      <p class="text-lg text-slate-400 mb-10">
        Astro + TypeScript + Tailwind CSS + Shadcn UI. Dark glassmorphism design system initialized and ready for the next steps.
      </p>

      <div class="glass-card p-6 mt-10 text-left">
        <h2 class="font-display text-xl font-semibold text-slate-100 mb-3">✅ Step 1 — Setup Complete</h2>
        <ul class="space-y-2 text-slate-300 text-sm">
          <li>• Astro 4 + TypeScript strict mode</li>
          <li>• Tailwind CSS with dark glassmorphism tokens</li>
          <li>• Shadcn UI primitives (button, card, dialog, input, progress, table, badge)</li>
          <li>• Nano Stores + persistent state</li>
          <li>• Lucide SVG icons</li>
          <li>• Backend CORS-ready environment configured</li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
