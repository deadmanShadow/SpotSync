---
// My Reservations page (`/my-reservations`).
//
// Driver-facing dashboard showing every booking the current user has
// made. Auth-guarded at the top of the client script: an unauthenticated
// visitor is bounced to `/login` before any data load happens.
//
// Layout (top to bottom):
//   1. Polished hero header with title, subtitle, live pulse, refresh.
//   2. 4-up KPI strip (Total / Active / Cancelled / Latest).
//   3. Toolbar: search-by-plate input + filter segmented pills.
//   4. Responsive grid of `ReservationCard` items.
//   5. Friendly empty state when the driver has no bookings.
//   6. Error state with retry.
//
// The page is statically rendered — the JWT goes on the next request
// automatically so the API call is performed client-side.

import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="My Reservations — SpotSync"
  description="View and manage your parking and EV charging reservations in real time."
>
  <main class="relative container mx-auto px-4 py-10 max-w-6xl">
    <!-- Ambient glow background -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-32 left-1/2 -translate-x-1/2 w-[42rem] h-[42rem] rounded-full bg-emerald-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/3 right-0 w-[28rem] h-[28rem] rounded-full bg-blue-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/4 w-[24rem] h-[24rem] rounded-full bg-purple-500/5 blur-3xl"
      >
      </div>
    </div>

    <!-- ============================== HEADER ============================== -->
    <header class="mb-10">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="min-w-0">
          <div class="flex items-center gap-2 mb-3">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-emerald-500/10 text-emerald-300 border border-emerald-500/30"
            >
              <span
                class="relative w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-emerald-400/60 shadow-sm"
                aria-hidden="true"
              >
                <span
                  class="absolute inset-0 rounded-full bg-emerald-400 animate-ping opacity-75"
                ></span>
              </span>
              Live Dashboard
            </span>
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-slate-800/60 text-slate-300 border border-slate-700/60"
              data-header-user
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              Driver
            </span>
          </div>
          <h1
            class="font-display text-4xl md:text-5xl font-bold text-slate-50 leading-tight tracking-tight"
          >
            My <span class="text-gradient-brand">Reservations</span>
          </h1>
          <p class="text-slate-400 mt-3 max-w-2xl">
            Manage every parking and EV charging spot you've reserved.
            Cancel active bookings at any time to release the spot back
            to the zone.
          </p>
        </div>

        <button
          type="button"
          data-action="refresh"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-slate-800/60 hover:bg-slate-700/80 text-slate-100 border border-slate-700/80 hover:border-slate-600 transition-all shadow-sm hover:shadow-md"
          aria-label="Refresh reservations"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true" data-refresh-icon>
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          Refresh
        </button>
      </div>
    </header>

    <!-- ============================== KPI STRIP ============================== -->
    <section
      class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10"
      aria-label="Reservation summary"
      data-kpi-section
    >
      <!-- Total -->
      <div
        class="relative overflow-hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-black/20 transition-all hover:border-slate-700"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-slate-500/10 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-400 font-bold">
            Total
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-slate-50" data-kpi-total>
          <span class="inline-block w-12 h-8 bg-slate-800/60 rounded animate-pulse"></span>
        </p>
      </div>

      <!-- Active -->
      <div
        class="relative overflow-hidden rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-emerald-950/40 to-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-emerald-500/10 transition-all hover:border-emerald-400/60 hover:shadow-emerald-500/20"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-emerald-500/20 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-emerald-300 font-bold">
            Active
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-emerald-200" data-kpi-active>
          <span class="inline-block w-12 h-8 bg-emerald-500/15 rounded animate-pulse"></span>
        </p>
      </div>

      <!-- Cancelled -->
      <div
        class="relative overflow-hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-black/20 transition-all hover:border-slate-700"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-slate-600/10 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-slate-400 font-bold">
            Cancelled
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-400"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-slate-300" data-kpi-cancelled>
          <span class="inline-block w-12 h-8 bg-slate-800/60 rounded animate-pulse"></span>
        </p>
      </div>

      <!-- Latest -->
      <div
        class="relative overflow-hidden rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-950/40 to-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-blue-500/10 transition-all hover:border-blue-400/60 hover:shadow-blue-500/20"
      >
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-blue-500/20 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex items-center justify-between mb-3">
          <span class="text-[0.65rem] uppercase tracking-[0.18em] text-blue-300 font-bold">
            Latest
          </span>
          <span
            class="w-9 h-9 rounded-xl bg-blue-500/15 border border-blue-400/30 flex items-center justify-center text-blue-300"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </span>
        </div>
        <p class="relative font-display text-3xl font-bold text-blue-200" data-kpi-latest>
          <span class="inline-block w-12 h-8 bg-blue-500/15 rounded animate-pulse"></span>
        </p>
      </div>
    </section>

    <!-- ============================== TOOLBAR ============================== -->
    <section
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6"
      data-toolbar
    >
      <!-- Segmented filter pills -->
      <div
        class="inline-flex items-center gap-1 p-1 bg-slate-900/60 border border-slate-800/80 rounded-xl shadow-inner"
        role="tablist"
        aria-label="Filter reservations by status"
        data-filter-tabs
      >
        <button
          type="button"
          role="tab"
          data-filter="all"
          aria-selected="true"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30"
        >
          All
        </button>
        <button
          type="button"
          role="tab"
          data-filter="active"
          aria-selected="false"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all text-slate-300 hover:text-slate-100 hover:bg-slate-800/60"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
          Active
        </button>
        <button
          type="button"
          role="tab"
          data-filter="cancelled"
          aria-selected="false"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all text-slate-300 hover:text-slate-100 hover:bg-slate-800/60"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-500" aria-hidden="true"></span>
          Cancelled
        </button>
      </div>

      <!-- Search by plate -->
      <div class="relative w-full md:w-72">
        <span
          class="absolute inset-y-0 left-3 flex items-center text-slate-500 pointer-events-none"
          aria-hidden="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input
          type="search"
          id="plate-search"
          placeholder="Search by license plate..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-900/60 border border-slate-800/80 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 focus:ring-2 focus:ring-emerald-500/20 transition-all"
          autocomplete="off"
        />
      </div>
    </section>

    <!-- ============================== LOADING SKELETON ============================== -->
    <section
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
      data-skeleton
      aria-hidden="true"
    >
      {Array.from({ length: 3 }).map((_, i) => (
        <div
          class="rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-black/20 overflow-hidden"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-slate-800/60 animate-pulse"></div>
            <div class="flex-1 space-y-2">
              <div class="h-2 w-16 bg-slate-800/60 rounded animate-pulse"></div>
              <div class="h-3 w-32 bg-slate-800/60 rounded animate-pulse"></div>
            </div>
          </div>
          <div class="h-16 bg-slate-800/40 rounded-xl mt-4 animate-pulse"></div>
          <div class="flex justify-between mt-4">
            <div class="h-8 w-24 bg-slate-800/60 rounded-lg animate-pulse"></div>
            <div class="h-4 w-16 bg-slate-800/60 rounded animate-pulse"></div>
          </div>
        </div>
      ))}
    </section>

    <!-- ============================== RESERVATION GRID ============================== -->
    <section
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 hidden"
      data-reservation-grid
      aria-live="polite"
    >
      <!-- Cards inserted by client script -->
    </section>

    <!-- ============================== EMPTY FILTER STATE ============================== -->
    <section
      class="hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-10 text-center shadow-xl shadow-black/20"
      data-filter-empty
      role="status"
    >
      <div
        class="w-16 h-16 mx-auto rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center mb-4"
        aria-hidden="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-slate-400">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h2 class="font-display text-lg font-semibold text-slate-100">
        No matching reservations
      </h2>
      <p class="text-slate-400 mt-1 text-sm">
        Try a different filter or clear your search.
      </p>
    </section>

    <!-- ============================== EMPTY STATE ============================== -->
    <section
      class="hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-12 text-center shadow-xl shadow-black/20"
      data-empty-state
      role="status"
    >
      <div
        class="w-24 h-24 mx-auto rounded-3xl bg-gradient-to-br from-emerald-500/20 via-blue-500/10 to-purple-500/15 border border-slate-700/60 flex items-center justify-center mb-6 shadow-inner"
        aria-hidden="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-emerald-300">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <h2 class="font-display text-2xl font-bold text-slate-50">
        All caught up!
      </h2>
      <p class="text-slate-400 mt-2 max-w-md mx-auto">
        You haven't reserved any parking or EV charging spots yet. Browse
        the catalog and lock in your first spot in seconds.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:from-emerald-400 hover:to-emerald-500 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Browse Parking Zones
      </a>
    </section>

    <!-- ============================== ERROR STATE ============================== -->
    <section
      class="hidden rounded-2xl border border-red-500/30 bg-red-950/20 backdrop-blur-md p-10 text-center shadow-xl shadow-red-500/10"
      data-error-state
      role="alert"
    >
      <div
        class="w-16 h-16 mx-auto rounded-2xl bg-red-500/15 border border-red-500/30 flex items-center justify-center mb-4"
        aria-hidden="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-red-300">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h2 class="font-display text-xl font-bold text-slate-50">
        Couldn't load your reservations
      </h2>
      <p class="text-slate-400 mt-2 max-w-md mx-auto" data-error-message>
        Please try again in a moment.
      </p>
      <button
        type="button"
        class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:from-blue-400 hover:to-blue-500 transition-all"
        data-action="retry"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
          <polyline points="23 4 23 10 17 10"></polyline>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>
        Try Again
      </button>
    </section>

    <!-- ============================== CANCEL DIALOG ============================== -->
    <div
      data-cancel-dialog
      class="hidden fixed inset-0 z-[100] items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cancel-dialog-title"
      aria-describedby="cancel-dialog-desc"
    >
      <div
        class="absolute inset-0 bg-black/70 backdrop-blur-sm"
        data-cancel-overlay
        aria-hidden="true"
      ></div>
      <div
        class="relative w-full max-w-md rounded-2xl border border-slate-800/80 bg-slate-900/95 backdrop-blur-xl p-6 shadow-2xl shadow-black/50"
      >
        <div class="flex items-start gap-4">
          <div
            class="shrink-0 w-12 h-12 rounded-xl bg-red-500/15 border border-red-500/30 flex items-center justify-center"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-red-300">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h3
              id="cancel-dialog-title"
              class="font-display text-lg font-bold text-slate-50"
            >
              Cancel this reservation?
            </h3>
            <p
              id="cancel-dialog-desc"
              class="text-sm text-slate-400 mt-1"
              data-cancel-dialog-message
            >
              The spot will be released back to the zone.
            </p>
          </div>
        </div>

        <div
          class="mt-5 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80"
          data-cancel-dialog-summary
        >
          <div class="flex items-center justify-between gap-3 text-sm">
            <span class="text-slate-400">Zone</span>
            <span
              class="font-semibold text-slate-100 truncate"
              data-cancel-dialog-zone
              >—</span
            >
          </div>
          <div class="flex items-center justify-between gap-3 text-sm mt-2">
            <span class="text-slate-400">License plate</span>
            <span
              class="font-mono font-bold text-slate-100 tracking-widest"
              data-cancel-dialog-plate
              >—</span
            >
          </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-2">
          <button
            type="button"
            class="px-4 py-2 rounded-xl text-sm font-semibold bg-slate-800/60 hover:bg-slate-700/80 text-slate-100 border border-slate-700/80 transition-all"
            data-cancel-dialog-dismiss
          >
            Keep it
          </button>
          <button
            type="button"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-gradient-to-r from-red-500 to-red-600 text-white shadow-lg shadow-red-500/30 hover:shadow-red-500/50 hover:from-red-400 hover:to-red-500 transition-all"
            data-cancel-dialog-confirm
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Cancel reservation
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Client-side controller for the My Reservations page.
  //
  // Responsibilities:
  //   1. Auth guard: unauthenticated visitors are redirected to /login.
  //   2. Fetch the current driver's reservations via the reservation
  //      service and render them into the grid.
  //   3. Filter tabs (All / Active / Cancelled) + plate search.
  //   4. Friendly relative-time labels (auto-refresh every 60s).
  //   5. Cancel-spot action with a custom modal dialog, optimistic UI,
  //      and reconciliation with the API response.
  //   6. Error / empty / filter-empty states + manual refresh.

  import { getUser, isAuthenticated } from "../store/authStore";
  import { cancelReservation, getMyReservations } from "../services/reservationService";
  import { ApiError } from "../services/api";
  import { toast } from "../lib/toast";
  import type { Reservation, ReservationStatus } from "../types/reservation";
  import type { ParkingZone, ZoneType } from "../types/zone";

  type FilterValue = "all" | "active" | "cancelled";

  // Component-scoped state.
  let allReservations: Reservation[] = [];
  let currentFilter: FilterValue = "all";
  let currentSearch = "";
  let isLoading = false;
  /** Reservation id currently queued for cancellation (resolved from dialog). */
  let pendingCancelId: number | null = null;

  // ---------------------------------------------------------------------------
  // Auth guard
  // ---------------------------------------------------------------------------

  function guardAuth(): NonNullable<ReturnType<typeof getUser>> | null {
    if (!isAuthenticated()) {
      window.location.replace("/login");
      return null;
    }
    const user = getUser();
    if (!user) {
      window.location.replace("/login");
      return null;
    }
    return user;
  }

  // ---------------------------------------------------------------------------
  // Rendering helpers
  // ---------------------------------------------------------------------------

  function showSection(
    name: "skeleton" | "grid" | "filter-empty" | "empty" | "error",
  ): void {
    const map = {
      skeleton: document.querySelector<HTMLElement>("[data-skeleton]"),
      grid: document.querySelector<HTMLElement>("[data-reservation-grid]"),
      "filter-empty": document.querySelector<HTMLElement>("[data-filter-empty]"),
      empty: document.querySelector<HTMLElement>("[data-empty-state]"),
      error: document.querySelector<HTMLElement>("[data-error-state]"),
    } as const;
    for (const [key, el] of Object.entries(map)) {
      if (!el) continue;
      el.classList.toggle("hidden", key !== name);
    }
  }

  function escapeHtml(input: string): string {
    return input
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function relativeTime(iso: string): string {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return "";
    const diffMs = Date.now() - then;
    const diffSec = Math.round(diffMs / 1000);
    if (diffSec < 45) return "just now";
    const diffMin = Math.round(diffSec / 60);
    if (diffMin < 60) return `${diffMin} min ago`;
    const diffHr = Math.round(diffMin / 60);
    if (diffHr < 24) return `${diffHr} hr ago`;
    const diffDay = Math.round(diffHr / 24);
    if (diffDay < 30) return `${diffDay} day${diffDay === 1 ? "" : "s"} ago`;
    const diffMonth = Math.round(diffDay / 30);
    if (diffMonth < 12)
      return `${diffMonth} month${diffMonth === 1 ? "" : "s"} ago`;
    const diffYear = Math.round(diffMonth / 12);
    return `${diffYear} year${diffYear === 1 ? "" : "s"} ago`;
  }

  /**
   * Format an ISO timestamp as `8-Aug-2026 15:38` (day-monthAbbr-year HH:MM
   * in 24h time, locale-independent so the same string renders for every
   * driver regardless of browser locale).
   *
   * Returns the raw ISO string as a graceful fallback when the input is
   * not a valid Date so we never display "Invalid Date".
   */
  function formatReservationDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;

    const MONTHS = [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ] as const;

    const day = d.getDate();
    const month = MONTHS[d.getMonth()];
    const year = d.getFullYear();
    const hh = String(d.getHours()).padStart(2, "0");
    const mm = String(d.getMinutes()).padStart(2, "0");

    return `${day}-${month}-${year} ${hh}:${mm}`;
  }

